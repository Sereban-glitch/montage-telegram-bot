[Unit]
Description=Montage Kitchen FIFO Worker (Sequential Render 12GB Protection)
After=network.target montage-webapp.service

[Service]
Type=simple
User=qwerty
WorkingDirectory=/home/qwerty/projects/montage-telegram-bot/services/worker
EnvironmentFile=/home/qwerty/projects/montage-telegram-bot/.env
ExecStart=/usr/bin/python3 worker.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
